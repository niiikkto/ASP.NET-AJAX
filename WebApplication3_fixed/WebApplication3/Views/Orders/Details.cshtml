@model WebApplication3.Web.Models.OrderDetailsViewModel
@{
    ViewData["Title"] = $"Заказ {Model.Id}";
}

<h1>Заказ @Model.Id</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<dl class="row">
    <dt class="col-sm-2">Клиент</dt>
    <dd class="col-sm-10">@Model.CustomerEmail</dd>

    <dt class="col-sm-2">Статус</dt>
    <dd class="col-sm-10">@Model.Status</dd>

    <dt class="col-sm-2">Создан (UTC)</dt>
    <dd class="col-sm-10">@Model.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-2">Сумма</dt>
    <dd class="col-sm-10">@Model.Total.ToString("N2")</dd>
</dl>

<h3>Позиции</h3>
<table class="table">
    <thead>
        <tr>
            <th>Товар</th>
            <th>Цена</th>
            <th>Количество</th>
            <th>Сумма</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Price.ToString("N2")</td>
            <td>@item.Quantity</td>
            <td>@((item.Price * item.Quantity).ToString("N2"))</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3">Итого</th>
            <th>@Model.Total.ToString("N2")</th>
        </tr>
    </tfoot>
</table>

@if (Model.CanBeCancelled)
{
    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger"
                onclick="return confirm('Отменить заказ?');">
            Отменить заказ
        </button>
    </form>
}

<p class="mt-3">
    <a asp-controller="Orders" asp-action="Create">Создать ещё заказ</a>
</p>
