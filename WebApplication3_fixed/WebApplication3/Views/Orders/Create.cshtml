@using Microsoft.AspNetCore.Mvc.Rendering
@using WebApplication3.Application.Products
@model WebApplication3.Web.Models.CreateOrderViewModel
@{
    ViewData["Title"] = "Новый заказ";
    var products = (IReadOnlyList<ProductDto>)(ViewBag.Products ?? new List<ProductDto>());
    var productItems = products
        .Select(p => new SelectListItem($"{p.Name} — {p.Price:N2} (в наличии: {p.Stock})", p.Id.ToString()))
        .ToList();
}

<h1>Новый заказ</h1>

<p class="text-muted">
    Тестовые клиенты: <code>ivan@example.com</code> (обычный),
    <code>blocked@example.com</code> (заблокирован).
</p>

<form asp-action="Create" method="post" id="order-form">
    @* Общая ошибка формы (из ModelState) *@
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="CustomerEmail">Email клиента</label>
        <input asp-for="CustomerEmail" class="form-control" />
        <span asp-validation-for="CustomerEmail" class="text-danger"></span>
    </div>

    <h3>Товары</h3>

    <table class="table" id="items-table">
        <thead>
            <tr>
                <th>Товар</th>
                <th>Количество</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td>
                        <select asp-for="Items[i].ProductId" asp-items="productItems" class="form-select"></select>
                        <span asp-validation-for="Items[i].ProductId" class="text-danger"></span>
                    </td>
                    <td>
                        <input asp-for="Items[i].Quantity" type="number" min="1" class="form-control" />
                        <span asp-validation-for="Items[i].Quantity" class="text-danger"></span>
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove">✕</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* Шаблон новой строки (содержимое <template> не отправляется с формой) *@
    <template id="row-template">
        <tr>
            <td>
                <select name="Items[__i__].ProductId" class="form-select">
                    @foreach (var p in productItems)
                    {
                        <option value="@p.Value">@p.Text</option>
                    }
                </select>
            </td>
            <td>
                <input name="Items[__i__].Quantity" type="number" min="1" value="1" class="form-control" />
            </td>
            <td>
                <button type="button" class="btn btn-sm btn-outline-danger btn-remove">✕</button>
            </td>
        </tr>
    </template>

    <button type="button" id="add-item" class="btn btn-secondary">+ Добавить товар</button>
    <hr />
    <button type="submit" class="btn btn-primary">Создать заказ</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const tbody = document.querySelector('#items-table tbody');
        const template = document.getElementById('row-template');

        document.getElementById('add-item').addEventListener('click', function () {
            tbody.appendChild(template.content.cloneNode(true));
        });

        // Удаление строки (работает и для строк, добавленных динамически)
        tbody.addEventListener('click', function (e) {
            if (e.target.closest('.btn-remove')) {
                e.target.closest('tr').remove();
            }
        });

        // Перед отправкой перенумеровываем Items[0], Items[1]...
        // Иначе после удаления строки в середине индексы с «дыркой» и ASP.NET не свяжет список.
        document.getElementById('order-form').addEventListener('submit', function () {
            tbody.querySelectorAll('tr').forEach(function (tr, index) {
                tr.querySelectorAll('select, input').forEach(function (el) {
                    el.name = el.name.replace(/Items\[[^\]]*\]/, 'Items[' + index + ']');
                });
            });
        });
    </script>
}
